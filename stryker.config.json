{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --config vitest.stryker.config.ts --bail=1 --reporter=dot"
  },
  "mutate": [
    "src/*.ts",
    "entrypoints/background.ts"
  ],
  "ignorePatterns": [
    ".baseline",
    ".test-browsers",
    ".test-profiles",
    "test-results",
    "playwright-report",
    "coverage",
    "reports",
    "tests/browser",
    "benchmarks",
    "docs",
    "assets",
    "scripts",
    "tmp",
    "temp"
  ],
  "tsconfigFile": "stryker.tsconfig.none.json",
  "coverageAnalysis": "off",
  "incremental": true,
  "incrementalFile": "reports/mutation/incremental.json",
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 8,
  "timeoutMS": 60000
}
